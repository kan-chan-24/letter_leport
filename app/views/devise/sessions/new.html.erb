<div class="max-w-md mx-auto my-10 px-4">
  <h2 class="text-2xl font-bold text-center mb-6">ログイン</h2>

  <% if session[:invite_token].present? %>
    <p class="text-sm text-center">
      <%= phrase_wrap("グループに参加するには、ログインしてください。\nはじめての方は新規登録へ") %>
    </p>
  <% end %>

  <%= form_with model: resource, as: resource_name, url: session_path(resource_name) do |f| %>
    <div class="mb-4">
      <%= f.label :email, class: "label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input input-bordered w-full" %>
    </div>

    <div class="mb-6">
      <%= f.label :password, class: "label" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "input input-bordered w-full" %>
    </div>

    <%= f.submit "ログイン", class: "btn btn-primary w-full" %>
  <% end %>

  <div class="text-center mt-4">
    <%= link_to "新規登録はこちら", new_user_registration_path, class: "link link-primary" %>
  </div>
</div>

<section class="max-w-6xl mx-auto px-4 py-16 md:py-16 grid lg:grid-cols-2 gap-12 items-center">
  <%# 左：キャッチコピーエリア %>
  <div>
    <h1 class="mt-6 text-3xl md:text-5xl lg:text-4xl xl:text-5xl font-bold leading-snug">
      <span class="inline-block">離れていても、</span><span class="inline-block">連絡不精でも。</span><br>
      <span class="inline-block"><span class="text-primary">お互いの気配</span>を</span><span class="inline-block">そっと</span><span class="inline-block">感じ合える場所。</span>
    </h1>

    <p class="mt-6 leading-relaxed text-base-content/70">
      ゆるやかな定期通知と、30秒で選べる「調子」の共有で、大切な家族や友人との疎遠を防ぐ近況報告サービスです。
    </p>

    <div class="mt-8 flex flex-col sm:flex-row gap-3">
      <%= link_to new_user_registration_path, class: "btn btn-primary btn-lg rounded-full h-auto py-3" do %>
        <span class="flex flex-col sm:flex-row sm:items-center leading-tight">
          <span>まずは無料で始める</span>
          <span class="text-sm font-normal sm:text-base sm:font-bold">（30秒登録）</span>
        </span>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      <% end %>
      <%= link_to "ログインはこちら", new_user_session_path,
 class: "btn btn-ghost btn-lg rounded-full bg-base-200" %>
    </div>
  </div>

  <%# 右：投稿イメージ（後で作成） %>
  <div></div>
</section>

<%# app/views/groups/edit.html.erb %>
<div class="p-6 max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold mb-6"><%= @group.name_was %>の設定</h1>

  <%= form_with model: @group do |f| %>
    <% if @group.errors.any? %>
      <ul class="text-error text-sm mb-4">
        <% @group.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <div class="mb-6">
      <%= f.label :name, "グループ名の変更", class: "label" %>
      <%= f.text_field :name, class: "input input-bordered w-full" %>
    </div>

    <div class="mb-6">
      <%= f.label :frequency, "通知頻度の変更", class: "label" %>
      <%= f.select :frequency,
            Group::FREQUENCY_PRESET.map { |key, preset| [preset[:label], key.to_s] },
            {},
            class: "select select-bordered w-full" %>
    </div>
    <div class="flex justify-end">
      <%= f.submit "設定を保存する", class: "btn btn-primary" %>
    </div>
  <% end %>

  <section class="mt-6 mb-6">
    <h3 class="label">メンバーの確認</h3>

    <ul class="mt-2 divide-y divide-base-300 rounded-box border border-base-300 bg-base-100">
      <% @group_members.each do |group_member| %>
        <li class="flex items-center justify-between gap-3 px-4 py-3">
          <div class="flex min-w-0 items-center gap-2">
            <% if group_member.host? %>
              <span class="badge w-18 badge-primary badge-sm shrink-0">ホスト</span>
            <% else %>
              <span class="badge w-18 badge-ghost badge-sm shrink-0">メンバー</span>
            <% end %>
            <span class="truncate font-medium"><%= group_member.user.name %></span>
          </div>

          <% unless group_member.host? %>
            <%= button_to "除籍する",
                  group_group_member_path(@group, group_member),
                  method: :delete,
                  class: "btn btn-outline btn-error btn-sm",
                  form: { class: "shrink-0",
                          data: { turbo_confirm: "#{group_member.user.name}さんをグループから外します。よろしいですか？" } } %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
</div>
